   "source": [
    "import pandas as pd\n",
    "\n",
    "data = {\n",
    "    'Name': ['Alice', 'Bob', 'Charlie', 'David', 'Eva'],\n",
    "    'Score': [85, 95, 95, 70, 90]\n",
    "}\n",
    "df = pd.DataFrame(data)\n",
    "\n",
    "# Get the top 2 rows based on 'Score'\n",
    "top_two = df.nlargest(2, 'Score')\n",
    "print(top_two)"
   ]
